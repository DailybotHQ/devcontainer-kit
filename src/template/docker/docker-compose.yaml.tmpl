# Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
# Blocks between ">>> dck:" and "<<< dck:" markers are reconciled by `dck init`;
# everything outside them is yours (add backing services after the marked block).
# >>> dck:project >>>
name: {{project}}
# <<< dck:project <<<

services:
  # >>> dck:service >>>
  {{service}}:
    build:
      context: ./{{service}}
      dockerfile: Dockerfile
    init: true
    working_dir: {{workspace}}
    command: ["sleep", "infinity"]
    volumes:
      - ../..:{{workspace}}:cached
      # Per-project named volumes (compose prefixes them with the project name).
{{volume_mounts}}
{% if has_ports %}
    ports:
      # Loopback only unless dck.toml sets `bind`.
{{port_lines}}
{% endif %}
    env_file:
      - path: ./{{service}}/.env
        required: false
    environment:
      DCK_USER: {{user}}
      DCK_WORKSPACE: {{workspace}}
      DCK_SSH: "{{ssh_enabled}}"
      DCK_EDITOR: "{{editor_enabled}}"
{% if layers_agents_on %}
      # Agents layer: one named volume per CLI home (persisted by the entrypoint);
      # ak profiles live on the agentkit volume. Every agent launched through ak
      # runs in autonomy (this container is the sandbox). To have agents ask
      # before acting instead, uncomment the opt-out:
      # AGENTKIT_PERMISSIONS=ask   # opt-out: agents ask before acting
      DCK_AGENTS: "{{agents_clis_space}}"
      AGENTKIT_PROFILES_DIR: /home/{{user}}/.dck/volumes/agentkit/profiles
{% endif %}
{% if layers_dailybot_on %}
      DCK_DAILYBOT: "1"
{% endif %}
      # Public key(s) dck authorizes for sshd; set by `dck up`, empty otherwise.
      DCK_AUTHORIZED_KEYS: "${DCK_AUTHORIZED_KEYS:-}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% if has_network %}
    networks:
      - default
      - {{network}}
{% endif %}
  # <<< dck:service <<<

# >>> dck:volumes >>>
volumes:
{{volume_decls}}
# <<< dck:volumes <<<
{% if has_network %}

# >>> dck:networks >>>
networks:
  {{network}}:
    external: true
    name: {{network}}
# <<< dck:networks <<<
{% endif %}
