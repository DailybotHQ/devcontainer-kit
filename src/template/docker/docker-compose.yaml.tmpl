# Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
# Blocks between ">>> dck:" and "<<< dck:" markers are reconciled by `dck init`;
# everything outside them is yours (add backing services after the marked block).
# >>> dck:project >>>
name: {{project}}
# <<< dck:project <<<

services:
  # >>> dck:service >>>
  {{service}}:
    build:
      context: ./{{service}}
      dockerfile: Dockerfile
    init: true
    working_dir: {{workspace}}
    command: ["sleep", "infinity"]
    volumes:
      - ../..:{{workspace}}:cached
      # Per-project named volumes (compose prefixes them with the project name).
{{volume_mounts}}
{% if ssh_agent_on %}
      # The host's SSH agent (git over SSH, signing) — never a key file. Docker
      # Desktop exposes it at this path; on a Linux host set DCK_HOST_SSH_AUTH_SOCK
      # (dck up and dck rebuild do it from $SSH_AUTH_SOCK). A missing host path
      # fails the start instead of being created.
      - type: bind
        source: ${DCK_HOST_SSH_AUTH_SOCK:-/run/host-services/ssh-auth.sock}
        target: /run/dck/ssh-agent.sock
        bind:
          create_host_path: false
{% endif %}
{% if has_ports %}
    ports:
      # Loopback only unless dck.toml sets `bind`.
{{port_lines}}
{% endif %}
    env_file:
      - path: ./{{service}}/.env
        required: false
    environment:
      DCK_USER: {{user}}
      DCK_WORKSPACE: {{workspace}}
      DCK_SSH: "{{ssh_enabled}}"
      DCK_EDITOR: "{{editor_enabled}}"
{% if ssh_agent_on %}
      SSH_AUTH_SOCK: /run/dck/ssh-agent.sock
{% endif %}
{% if layers_agents_on %}
      # Agents layer: one named volume per CLI home (persisted by the entrypoint);
      # ak profiles live on the agentkit volume. Every agent launched through ak
      # runs in autonomy (this container is the sandbox). Opt-out — agents ask
      # before acting: set AGENTKIT_PERMISSIONS=ask in ./{{service}}/.env (this
      # block is reconciled by `dck init`; the .env is yours).
      DCK_AGENTS: "{{agents_clis_space}}"
      AGENTKIT_PROFILES_DIR: /home/{{user}}/.dck/volumes/agentkit/profiles
{% endif %}
{% if layers_dailybot_on %}
      DCK_DAILYBOT: "1"
{% endif %}
      # Public key(s) dck authorizes for sshd; set by `dck up`, empty otherwise.
      DCK_AUTHORIZED_KEYS: "${DCK_AUTHORIZED_KEYS:-}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% if has_network %}
    networks:
      - default
      - {{network}}
{% endif %}
  # <<< dck:service <<<

# >>> dck:volumes >>>
volumes:
{{volume_decls}}
# <<< dck:volumes <<<
{% if has_network %}

# >>> dck:networks >>>
networks:
  {{network}}:
    external: true
    name: {{network}}
# <<< dck:networks <<<
{% endif %}
