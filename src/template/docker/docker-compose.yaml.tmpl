# Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
# Blocks between ">>> dck:" and "<<< dck:" markers are reconciled by `dck init`;
# everything outside them is yours (add backing services after the marked block).
# >>> dck:project >>>
name: {{project}}
# <<< dck:project <<<

services:
  # >>> dck:service >>>
  {{service}}:
    build:
      context: {{build_context}}
      dockerfile: {{build_dockerfile}}
{% if layers_agents_on %}
      args:
        # The coding-agent CLIs installed in YOUR image: dck.toml [agents] clis,
        # unless you set DCK_AGENT_CLIS (docker/local/.env, the shell, or your host
        # profile's [agents] clis / clis_extra through dck up), plus each
        # INSTALL_<CLI>_CLI=true. Then `dck rebuild`. Every supported CLI is wired.
        DCK_AGENT_CLIS: "${DCK_AGENT_CLIS:-{{agents_clis_space}}}"
{{install_arg_lines}}
{% endif %}
    init: true
    working_dir: {{workspace}}
    command: ["sleep", "infinity"]
    volumes:
      - ../..:{{workspace}}:cached
      # Per-project named volumes (compose prefixes them with the project name).
{{volume_mounts}}
{% if ssh_agent_on %}
      # The host's SSH agent (git over SSH, signing) — never a key file. Docker
      # Desktop and OrbStack expose it at this path; dck up/rebuild and dev.sh's
      # plain-compose fallback set DCK_HOST_SSH_AUTH_SOCK by provider ($SSH_AUTH_SOCK
      # on a native Linux engine, /dev/null elsewhere). A missing host path fails
      # the start instead of being created: a bare `docker compose up` on another
      # provider needs DCK_HOST_SSH_AUTH_SOCK=/dev/null (or ssh_agent = false).
      - type: bind
        source: ${DCK_HOST_SSH_AUTH_SOCK:-/run/host-services/ssh-auth.sock}
        target: /run/dck/ssh-agent.sock
        bind:
          create_host_path: false
{% endif %}
{% if has_ports %}
    ports:
      # Loopback only unless dck.toml sets `bind`.
{{port_lines}}
{% endif %}
    env_file:
      - path: ./{{service}}/.env
        required: false
    environment:
      DCK_USER: {{user}}
      DCK_WORKSPACE: {{workspace}}
      DCK_SSH: "{{ssh_enabled}}"
      DCK_EDITOR: "{{editor_enabled}}"
{% if ssh_agent_on %}
      SSH_AUTH_SOCK: /run/dck/ssh-agent.sock
{% endif %}
{% if layers_agents_on %}
      # Agents layer: one named volume per supported CLI's home, installed or
      # not (persisted by the entrypoint); ak profiles live on the agentkit
      # volume. Every agent launched through ak runs in autonomy (this container
      # is the sandbox). Opt-out — agents ask before acting:
      # set AGENTKIT_PERMISSIONS=ask in ./{{service}}/.env (this block is
      # reconciled by `dck init`; the .env is yours).
      DCK_AGENTS: "{{agents_supported_space}}"
      AGENTKIT_PROFILES_DIR: /home/{{user}}/.dck/volumes/agentkit/profiles
{% endif %}
{% if layers_dailybot_on %}
      DCK_DAILYBOT: "1"
{% endif %}
      # Public key(s) dck authorizes for sshd; set by `dck up`, empty otherwise.
      DCK_AUTHORIZED_KEYS: "${DCK_AUTHORIZED_KEYS:-}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% if has_network %}
    networks:
      - default
{{network_lines}}
{% endif %}
  # <<< dck:service <<<

# >>> dck:volumes >>>
volumes:
{{volume_decls}}
# <<< dck:volumes <<<
{% if has_network_decls %}

# >>> dck:networks >>>
networks:
{{network_decls}}
# <<< dck:networks <<<
{% endif %}
