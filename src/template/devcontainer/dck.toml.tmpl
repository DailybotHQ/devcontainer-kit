# devcontainer-kit config for this repository (interface 2).
# Reference: https://github.com/DailybotHQ/devcontainer-kit/blob/{{dck_tag}}/docs/config.md
# Edit this file, then run `dck init` to reconcile the generated files.
interface = 2

# Compose service the tools attach to, its user and workspace folder.
service = "{{service}}"
user = "{{user}}"
workspace = "{{workspace}}"

# Runtime: python-3.13 | node-24 | debian. The Dockerfile starts FROM that
# runtime's official image, pinned by digest in docker/local/<service>/dck/versions.env.
flavour = "{{flavour}}"
# Optional: a different official image for the runtime, pinned by digest, e.g.
# base_image = "node:22.20.0-trixie-slim@sha256:<64 hex>"

# Share the host's SSH agent with the container (git over SSH; keys never enter it).
ssh_agent = {{ssh_agent}}

# Loopback-only host port for the container's sshd (Herdr, `dck ssh`); 0 = no sshd.
ssh_port = {{ssh_port}}

# Named ports, each published as 127.0.0.1:<port>:<port>, e.g. { web = 4321 }.
ports = { {{ports_inline}} }

[layers]
# true → installs coding-agents-kit (ak) at its pinned tag; see [agents].
agents = {{layers_agents}}
# true only when the dailybot addon asks for it.
dailybot = {{layers_dailybot}}
# nvim + deepworkplan-vim as the default editor.
editor = {{layers_editor}}

[agents]
# Kinds passed to `ak install` when layers.agents is true.
clis = [{{agents_clis_toml}}]

[herdr]
# Register the container as a Herdr machine on `dck up` (needs ssh_port).
machine = {{herdr_machine}}
label = "{{herdr_label_fmt}}"
# The sidebar `dck up` creates inside the container: "standard" (Home · Editor ·
# Development · Agents) or "none".
layout = "{{herdr_layout}}"
