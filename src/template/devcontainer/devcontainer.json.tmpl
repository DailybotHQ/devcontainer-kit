// Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
// dck reconciles: dockerComposeFile, service, runServices, remoteUser,
// workspaceFolder, shutdownAction. Every other key is yours.
{
  "name": "{{repo_name}}",
  "dockerComposeFile": "../docker/local/docker-compose.yaml",
  "service": "{{service}}",
  "runServices": ["{{service}}"],
  "remoteUser": "{{user}}",
  "workspaceFolder": "{{workspace}}",
  // Keep the stack running when the editor window closes; `dck down` stops it.
  "shutdownAction": "none"
}
