# project's own layers BELOW them — they are never touched. The scripts the
# base block copies live next to this file in dck/ (vendored by `dck init`,
# devcontainer-kit v0.3.2); no shared base image is involved.
# >>> dck:base >>>
# dck:managed v0.3.6 base
# Both ARGs come before any FROM, so they are global (an ARG after a FROM is
# scoped to that stage).
ARG BASE_IMAGE=python:3.13.16-slim-trixie@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a
FROM ${UV_IMAGE} AS uv
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# System packages, hardened sshd (no host keys in the image), gh, Herdr,
# Neovim and the uid-1000 user — every download pinned and verified
# (dck/versions.env, dck/install.sh).
COPY dck/versions.env dck/install.sh dck/sshd_config.conf dck/github_known_hosts dck/herdr-config.toml dck/profile.sh /tmp/dck-build/
RUN bash /tmp/dck-build/install.sh python-3.13 nodejs npm

# herdr-peers and Herdr's skill: agents inside ask Herdr agents on other
# machines (the host, other containers). Verified against the pinned release
# sums (dck/peers.sh).
COPY dck/versions.env dck/peers.sh /tmp/dck-peers/
RUN bash /tmp/dck-peers/peers.sh && rm -rf /tmp/dck-peers
COPY --from=uv /uv /uvx /usr/local/bin/
RUN uv --version

# The editor in its own layer: DeepWorkPlan Vim through its official
# installer, verified and run with --strict (dck/editor.sh).
COPY dck/versions.env dck/editor.sh /tmp/dck-editor/
RUN bash /tmp/dck-editor/editor.sh

# The entrypoint library and the opt-in layer installers (dck/).
COPY dck/entrypoint.sh /usr/local/lib/dck/entrypoint.sh
COPY dck/dck-entrypoint /usr/local/bin/dck-entrypoint
COPY dck/layers/ /usr/local/lib/dck/layers/
COPY dck/dck-layer /usr/local/bin/dck-layer
# The standard Herdr sidebar (App · Editor · Development · Agents), created by
# `dck herdr layout` / `dck up` inside the container.
COPY dck/herdr-layout.sh /usr/local/bin/dck-herdr-layout
RUN chmod 0644 /usr/local/lib/dck/entrypoint.sh /usr/local/lib/dck/layers/*.sh \
    && chmod 0755 /usr/local/bin/dck-entrypoint /usr/local/bin/dck-layer /usr/local/bin/dck-herdr-layout

ENV LANG=en_US.UTF-8 \
    EDITOR=nvim \
    VISUAL=nvim \
    GIT_EDITOR=nvim \
    DCK_IMAGE_FLAVOUR=python-3.13 \
    DCK_IMAGE_VERSION=0.3.6
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/dck-entrypoint"]
CMD ["sleep", "infinity"]
# <<< dck:base <<<
# >>> dck:layers >>>
# Agents layer (layers.agents = true): coding-agents-kit (ak) from its verified
# release, the pinned Node when the flavour lacks a current one, `ak install`
# (pinned, verified) and the classic + providers presets. Autonomy is ak's default.
# The CLIs installed: DCK_AGENT_CLIS plus each INSTALL_<CLI>_CLI=true (compose
# passes both from the developer's environment or docker/local/.env).
ARG DCK_AGENT_CLIS="claude codex cursor opencode pi cline grok antigravity"
ARG INSTALL_CLAUDE_CLI=false
ARG INSTALL_CODEX_CLI=false
ARG INSTALL_CURSOR_CLI=false
ARG INSTALL_OPENCODE_CLI=false
ARG INSTALL_PI_CLI=false
ARG INSTALL_CLINE_CLI=false
ARG INSTALL_GROK_CLI=false
ARG INSTALL_ANTIGRAVITY_CLI=false
RUN DCK_USER=dev DCK_AGENT_SUPPORTED="claude codex cursor opencode pi cline grok antigravity" dck-layer agents ${DCK_AGENT_CLIS}
# <<< dck:layers <<<

# Project-specific layers go here (apt packages, language tooling, ...).
# The repository's own gate inside the container: shellcheck (bash tests/run.sh
# and the lint line in AGENTS.md). The docker scope reports "unavailable" here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends shellcheck \
    && rm -rf /var/lib/apt/lists/*
