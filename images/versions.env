# devcontainer-kit base images — the single pin file.
#
# Every external input of the base images is pinned here: base images by tag
# AND digest, every downloaded tool by version AND SHA-256 per architecture,
# deepworkplan-vim by tag AND commit. images/common/install.sh refuses any
# download whose checksum does not match. The Dockerfiles' FROM defaults must
# equal the BASE_* values below (the `images` test scope enforces it).
#
# Format: KEY=value, no spaces, no shell expansion. Sourced by install.sh and
# read by .github/workflows/images.yml and `dck doctor` (drift).
#
# Checksum provenance (recorded 2026-10-09):
#   gh, herdr  — GitHub release asset digests published by the vendor
#   node       — nodejs.org SHASUMS256.txt for the release
#   nvim       — computed at pin time from the release tarballs (Neovim
#                publishes no checksum file for v0.12.5)

# Base images
BASE_PYTHON=python:3.13.16-slim-trixie@sha256:bf44cdfcb76cd3b41e879bc058fc37ec5872002ccfde7fcb765e218cde0cd79c
BASE_NODE=node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66
BASE_DEBIAN=debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a

# GitHub CLI
GH_VERSION=2.102.0
GH_SHA256_AMD64=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
GH_SHA256_ARM64=7862c86c72f43df3a2d93ddde6f473285b4e2af61b494849846827e513ef6484

# Herdr (terminal workspace manager; the container joins it as an SSH machine)
HERDR_VERSION=0.9.3
HERDR_SHA256_AMD64=18a8dc65f1c2fa485884344356dea1cfd911c6f06cf46fa78e193f4087f4dba7
HERDR_SHA256_ARM64=4de7aa3e25678812e92960de64f7c2aaa1bca1f0f80a3c5e559837e231e1f5c0

# Neovim (official release tarball)
NVIM_VERSION=0.12.5
NVIM_SHA256_AMD64=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
NVIM_SHA256_ARM64=1aa5ca085249580ae0f91eb14f27ec0919773ff2d99a163d03f3d6c21ac29725

# deepworkplan-vim (editor configuration, GPL-3.0) — tag and the commit it must resolve to
DWP_VIM_TAG=v0.3.1
DWP_VIM_COMMIT=706cd54f4225132825eb0e79ebc112d72a79e89f

# Node.js for the agents layer on flavours without Node (python-3.13, debian)
NODE_VERSION=24.21.0
NODE_SHA256_AMD64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2

# coding-agents-kit tag installed by the agents layer (opt-in, never in the base)
AGENTKIT_TAG=v0.1.0

# Dailybot CLI for the dailybot layer (opt-in, only when the dailybot addon asks;
# installed from PyPI with the wheel hash pinned, never in the base)
DAILYBOT_CLI_VERSION=3.27.0
DAILYBOT_CLI_WHEEL_SHA256=3c73edef557a652f8caad0729d977e5b66cbcd05754a52ed4f8f28613da9c279
