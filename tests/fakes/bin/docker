#!/usr/bin/env bash
# Fake docker CLI for the unit scopes. Logs argv, answers from $DCK_FAKE_STATE:
#   daemon_down          `docker info` fails
#   digest               printed as the manifest digest by `buildx imagetools inspect`
#   ps                   stdout of `docker ps ...` and `docker compose ... ps ...`
#   ps_mounts            stdout of `docker ps ... --format '<service>\t<mounts>'` (the doctor)
#   exec_out / exec_rc   stdout / status of `docker compose ... exec ...`
#   compose_rc           status of every other `docker compose ...` call
#   net_<name>           an existing network
#   inspect_out          stdout of `docker inspect ...`
#   volumes              stdout of `docker volume ls ...`
#   info_out             stdout of `docker info` ("version|os|name")
#   image_inspect_out    stdout of `docker image inspect` (RepoDigests JSON)
#   container_image_env  /etc/dck/image.env as `docker exec` would print it
#   container_ssh_manifest  ~/.ssh/.dck-copied-keys as `docker exec` would print it
#   container_herdr_self    ~/.dck/volumes/state/herdr-self as `docker exec` would print it
st="${DCK_FAKE_STATE:-/nonexistent}"
printf 'docker %s\n' "$*" >> "${DCK_FAKE_LOG:-/dev/null}"
# Record stdin for exec calls that pipe data in (e.g. authorized keys).
case " $* " in *" exec "*" -i "*|*" exec -i "*) cat > "$st/exec_stdin" 2>/dev/null ;; esac
case "$1" in
  info)
    [ -f "$st/daemon_down" ] && { echo "Cannot connect to the Docker daemon" >&2; exit 1; }
    if [ -f "$st/info_out" ]; then cat "$st/info_out"; else echo "29.0.0|Ubuntu 24.04|host"; fi
    exit 0 ;;
  version) echo "29.0.0"; exit 0 ;;
  image)
    # docker image inspect ... -> $st/image_inspect_out (RepoDigests JSON)
    [ -f "$st/image_inspect_out" ] || { echo "No such image" >&2; exit 1; }
    cat "$st/image_inspect_out"; exit 0 ;;
  exec)
    # docker exec <container> cat ~/.ssh/.dck-copied-keys -> $st/container_ssh_manifest
    case "${*: -1}" in
      */.ssh/.dck-copied-keys) [ -f "$st/container_ssh_manifest" ] || exit 1
        cat "$st/container_ssh_manifest"; exit 0 ;;
      */.dck/volumes/state/herdr-self) [ -f "$st/container_herdr_self" ] || exit 1
        cat "$st/container_herdr_self"; exit 0 ;;
    esac
    # docker exec <container> cat /etc/dck/image.env -> $st/container_image_env
    [ -f "$st/container_image_env" ] || exit 1
    cat "$st/container_image_env"; exit 0 ;;
  buildx)
    if [ "$2 $3" = "imagetools inspect" ]; then
      [ -f "$st/digest" ] || { echo "not found" >&2; exit 1; }
      printf '{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"%s","size":1}\n' "$(cat "$st/digest")"
      exit 0
    fi
    exit 0 ;;
  ps)
    # The doctor's shared-project check asks for services and mounts.
    case "$*" in *".Mounts"*) cat "$st/ps_mounts" 2>/dev/null; exit 0 ;; esac
    cat "$st/ps" 2>/dev/null; exit 0 ;;
  inspect) cat "$st/inspect_out" 2>/dev/null; [ -f "$st/inspect_out" ]; exit $? ;;
  volume) cat "$st/volumes" 2>/dev/null; exit 0 ;;
  network)
    case "$2" in
      inspect) [ -f "$st/net_$3" ]; exit $? ;;
      create) touch "$st/net_$3"; exit 0 ;;
    esac
    exit 0 ;;
  compose)
    printf '%s' "${DCK_AUTHORIZED_KEYS:-}" > "$st/last_authorized_keys" 2>/dev/null
    printf '%s' "${DCK_HOST_SSH_AUTH_SOCK:-}" > "$st/last_agent_sock" 2>/dev/null
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|-f|--project-name|--file) shift 2 ;;
        version) echo "Docker Compose version v2.99.0-fake"; exit 0 ;;
        ps) cat "$st/ps" 2>/dev/null; exit 0 ;;
        exec)
          # The host key read by ssh_pin_host_key: $st/host_key_pub (nothing when absent).
          case " $* " in *dck_host_key_pub*) cat "$st/host_key_pub" 2>/dev/null; exit 0 ;; esac
          # dck_herdr_self takes its id as an argument: its empty stdin is not a payload.
          case "$*" in *dck_herdr_self*) ;; *) [ -t 0 ] || cat > "$st/exec_stdin" ;; esac
          cat "$st/exec_out" 2>/dev/null; exit "$(cat "$st/exec_rc" 2>/dev/null || echo 0)" ;;
        *) break ;;
      esac
    done
    exit "$(cat "$st/compose_rc" 2>/dev/null || echo 0)" ;;
esac
exit 0
